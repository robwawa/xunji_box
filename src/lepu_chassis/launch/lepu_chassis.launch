<launch>
  <!-- Lepu Chassis Driver -->
  <arg name="port" default="/dev/ttyACM0" doc="Serial port for chassis"/>
  <arg name="baudrate" default="115200" doc="Serial baudrate"/>
  <arg name="config_file" default="$(find lepu_chassis)/config/lepu_chassis.yaml" doc="YAML parameter file"/>

  <!-- Load parameters from YAML -->
  <rosparam file="$(arg config_file)" command="load" ns="lepu_chassis_node"/>

  <!-- Override with launch args if specified -->
  <param name="lepu_chassis_node/port" value="$(arg port)" if="$(eval port != '/dev/ttyACM0')"/>
  <param name="lepu_chassis_node/baudrate" value="$(arg baudrate)" if="$(eval baudrate != 115200)"/>

  <!-- Chassis node -->
  <node name="lepu_chassis_node" pkg="lepu_chassis" type="lepu_chassis_node.py" output="screen" respawn="true">
  </node>

</launch>
