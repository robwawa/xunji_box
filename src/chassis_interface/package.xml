<?xml version="1.0"?>
<package format="2">
  <name>chassis_interface</name>
  <version>1.0.0</version>
  <description>
    Generic chassis interface for navigation systems.
    Plugin-based architecture: any chassis can be integrated by implementing a ChassisDriver plugin.
  </description>
  <maintainer email="user@example.com">wa</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>diagnostic_updater</build_depend>
  <build_depend>std_srvs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <chassis_interface plugin="${prefix}/plugins/chassis_interface_plugin.xml" />
  </export>
</package>
