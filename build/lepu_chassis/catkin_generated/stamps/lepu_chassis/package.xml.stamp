<?xml version="1.0"?>
<package format="2">
  <name>lepu_chassis</name>
  <version>1.0.0</version>
  <description>Lepu car chassis driver — odometry publishing and cmd_vel control via SLAM 3.0 serial API (ROS1)</description>
  <maintainer email="wa@123456.com">wa</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>tf</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>python-serial</exec_depend>

  <export>
  </export>
</package>
